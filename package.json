{
  "name": "fyspoti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "services/cloud"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:frontend && npm run build:desktop",
    "typecheck": "tsc -b && tsc -p tsconfig.frontend.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.electron.json",
    "pretest": "npm run build:packages",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run typecheck && npm test && npm run check --workspace @fyspoti/contracts",
    "import:preview": "npm run build --silent && node scripts/spotify-import-preview.mjs",
    "test:integration": "node scripts/run-local-integration.mjs",
    "test:migrations": "node scripts/check-library-upgrade.mjs",
    "pretest:integration": "npm run build",
    "test:cloud": "node --env-file=.env.cloud ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "pretest:cloud": "npm run build",
    "cloud:start": "supabase start --workdir services/cloud",
    "cloud:reset": "supabase db reset --local --workdir services/cloud",
    "cloud:stop": "supabase stop --workdir services/cloud",
    "cloud:advisors": "supabase db advisors --local --workdir services/cloud",
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "setup:desktop": "node node_modules/electron/install.js",
    "build:packages": "tsc -b",
    "build:frontend": "tsc -p tsconfig.frontend.json && vite build",
    "build:desktop": "vite build -c vite.electron.config.ts --mode main && vite build -c vite.electron.config.ts --mode preload"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.1",
    "vite": "6.4.5"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "main": "dist-electron/main.cjs"
}
